                </mxCell>
                <mxCell id="repoNote" value="&lt;font style=&quot;font-size:11px&quot;&gt;判断基準：「決まっていないと2人が別実装するか？&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Yes なら設計書に書く」。&lt;br&gt;同じ情報の正本は1箇所だけ（二重管理しない）。&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#6B6B6A;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="42" y="460" width="294" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="branch" value="&lt;b&gt;機械可読度で&lt;br&gt;振り分け&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#1F1F1D;" parent="1" vertex="1">
                    <mxGeometry x="360" y="328" width="90" height="40" as="geometry"/>
