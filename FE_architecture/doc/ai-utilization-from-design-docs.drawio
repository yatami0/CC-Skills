                <mxCell id="repoTitle" value="&lt;b&gt;設計書リポジトリ design-docs（SSOT）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;コードと分離した専用リポジトリ。&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size:11px&quot;&gt;人間が仕様を書く（AIは補助）&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1F1F1D;spacingLeft=8;" parent="1" vertex="1">
