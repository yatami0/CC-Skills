                <mxCell id="genPanel" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F5FE;strokeColor=#534AB7;arcSize=4;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="550" y="100" width="470" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="genTitle" value="&lt;b&gt;① 自動生成できるもの（構造化済みの成果物）→ コードを機械生成&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ジェネレータにかける。生成物は手で触らない&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#3C3489;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="562" y="108" width="438" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="genMap" value="&lt;font style=&quot;font-size:12px&quot;&gt;・openapi.yaml　→　型 / API クライアント / Zod / モック&lt;br&gt;・区分値（ENUM）　→　enum・定数・型&lt;br&gt;・メッセージ定義　→　メッセージカタログ・キー型&lt;br&gt;・データモデル（ERD）　→　型（必要なら BE エンティティ）&lt;br&gt;・メタデータ定義　→　マスタ画面をランタイム駆動（コード追加ゼロ）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;align=left;verticalAlign=middle;arcSize=8;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="562" y="158" width="438" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="genGate" value="&lt;b&gt;機械ゲート&lt;/b&gt;　再生成で差分ゼロ（drift 検出）／ 生成物の手書き改変禁止" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#3C3489;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="562" y="298" width="438" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="genAI" value="&lt;font style=&quot;font-size:11px&quot;&gt;AI の関与：生成設定・スキーマ整形・自動生成の配線まで（生成物そのものは書かない）&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0C447C;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="562" y="330" width="438" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="codePanel" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F7FD;strokeColor=#185FA5;arcSize=4;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="550" y="392" width="510" height="248" as="geometry"/>
                </mxCell>
                <mxCell id="codeTitle" value="&lt;b&gt;② 自動生成できないもの（ロジック・振る舞い）→ AI が仕様をコードに落とす&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;自然言語＋表で書かれた設計書を AI が読んで実装&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0C447C;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="562" y="400" width="478" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="codeBody" value="&lt;font style=&quot;font-size:12px&quot;&gt;・画面設計書　→　API 呼び出し / イベント / バリデーション / 画面遷移 /&lt;br&gt;　　データ状態（loading・empty・error・success）の実装&lt;br&gt;・UI 設計　→　Figma を正本に AI が実装（見た目は設計書に書かない）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;align=left;verticalAlign=middle;arcSize=8;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="562" y="450" width="478" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="codeHuman" value="&lt;b&gt;人間&lt;/b&gt;　業務ロジックの正しさをレビュー（AI の実装を追認＝ラバースタンプしない）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAECE7;strokeColor=#993C1D;fontColor=#712B13;align=left;verticalAlign=middle;fontSize=12;arcSize=8;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="562" y="560" width="478" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="codeGate" value="&lt;font style=&quot;font-size:11px&quot;&gt;機械ゲート：型（生成物との整合）/ lint / 単体テスト / E2E が AI 実装を裏で落とす&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontColor=#3C3489;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="562" y="600" width="600" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#534AB7;strokeWidth=2;endArrow=block;fontColor=#3C3489;fontSize=11;" parent="1" source="repoPanel" target="genPanel" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="360" y="235" as="sourcePoint"/>
