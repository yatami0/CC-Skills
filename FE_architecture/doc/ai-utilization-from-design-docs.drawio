                    </mxGeometry>
                </mxCell>
                <mxCell id="e1l" value="構造化（機械可読）" style="text;html=1;align=center;fontSize=11;fontColor=#3C3489;" parent="1" vertex="1">
                    <mxGeometry x="424" y="194" width="110" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#185FA5;strokeWidth=2;endArrow=block;fontColor=#0C447C;fontSize=11;" parent="1" source="repoPanel" target="codePanel" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="360" y="500" as="sourcePoint"/>
                        <mxPoint x="490" y="500" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e2l" value="自然言語＋表（ロジック）" style="text;html=1;align=center;fontSize=11;fontColor=#0C447C;" parent="1" vertex="1">
                    <mxGeometry x="410" y="530" width="124" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="&lt;b&gt;前提と原則&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;・design-docs を専用リポジトリとして切り出し SSOT にする（コードとは分離）。&lt;br&gt;・&lt;b&gt;機械&lt;/b&gt; = 構造化済みの成果物を自動生成し、drift を検出（生成物は手で触らない）。&lt;b&gt;AI&lt;/b&gt; = 自動生成できないロジック・振る舞いの仕様をコードに翻訳。&lt;b&gt;人間&lt;/b&gt; = 設計書（仕様・意図）を書き、業務ロジックをレビュー。&lt;br&gt;・左の「開発フロー」図の各段階を、本図では『設計書 → 自動生成 / 仕様→コード』の供給源の側から捉え直したもの。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=13;align=left;verticalAlign=middle;arcSize=6;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="30" y="678" width="1080" height="100" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
