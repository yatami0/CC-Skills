{
  "name": "@poc/contracts-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "contracts駆動開発 V-1/V-2/V-3 検証 PoC (TS-only, orval + dependency-cruiser + ESLint + MSW/Vitest)",
  "scripts": {
    "bundle": "redocly bundle contracts/http/poc-master-api.yaml -o contracts/.bundled/poc-master-api.bundled.yaml",
    "codegen": "pnpm bundle && orval --config ./orval.config.ts && prettier --write \"packages/api-client/src/generated/**/*.ts\"",
    "codegen:check": "pnpm codegen && git diff --exit-code -- packages/api-client/src/generated",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "depcruise": "depcruise --config .dependency-cruiser.cjs services packages",
    "depcruise:graph": "depcruise --config .dependency-cruiser.cjs --output-type mermaid --output-to doc/v-2/dependency-graph.mmd services packages",
    "depcruise:affected": "depcruise --config .dependency-cruiser.cjs --output-type mermaid --affected --output-to doc/v-2/affected-graph.mmd services packages",
    "test": "vitest run",
    "verify": "pnpm codegen:check && pnpm typecheck && pnpm lint && pnpm depcruise && pnpm test"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "jotai": "^2.10.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "ts-pattern": "^5.6.0",
    "zod": "^3.22.3"
  },
  "devDependencies": {
    "@redocly/cli": "^1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dependency-cruiser": "^16",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "msw": "^2.14.6",
    "orval": "^7",
    "prettier": "^3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8",
    "vitest": "^2.1.9"
  }
}
