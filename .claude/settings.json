{
  "permissions": {
    "allow": [
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(git status)",
      "Bash(git diff*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git submodule*)",
      "Bash(pnpm add*)",
      "Bash(pnpm remove*)",
      "Edit(packages/service/src/external/api/**)"
    ],
    "deny": [
      "Read(./**/.env*)",
      "Read(./**/secrets/**)",
      "Edit(patches/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "pnpm lint --silent || true" }
        ]
      }
    ]
  }
}
